{
  "name": "smartkasi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "turbo lint",
    "contract:lint": "npx @redocly/cli lint packages/contract/openapi.yaml",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:status": "npx supabase status",
    "supabase:types": "npx supabase gen types typescript --local > packages/types/supabase.ts",
    "supabase:migration:new": "npx supabase migration new",
    "supabase:diff": "npx supabase db diff -f"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.4.6",
    "turbo": "^2.10.11"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.6",
    "@astryxdesign/theme-neutral": "^0.4.6",
    "@stylexjs/stylex": "^0.19.0",
    "@supabase/server": "^1.4.1",
    "supabase": "^2.115.0"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "warn"
    }
  }
}
