# ---- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=v1

# ---- Database --------------------------------------------------------------
# Supabase > Connect > ORMs > Prisma gives you both of these. Copy them here,
# NOT into .env.local as the dashboard suggests — either works, but keeping one
# convention across the team saves an evening.
#
# DATABASE_URL  transaction-mode pooler, port 6543. What the API connects with.
#               IPv4-only, which is why it is the pooler and not db.<ref>.
# DIRECT_URL    session-mode pooler, port 5432. Used ONLY by the Prisma CLI.
#               The 6543 pooler cannot run introspection or DDL, so `prisma db
#               pull` fails against it with a confusing error.
DATABASE_URL="postgresql://postgres.PROJECT:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres" 
#
# Percent-encode the password if it contains @ / : or # — an unencoded @ splits
# the userinfo at the wrong place and surfaces as a host or auth failure.

# ---- Supabase auth ---------------------------------------------------------
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # server only. NEVER ship to a client.

# Legacy Supabase projects sign JWTs with HS256 and this shared secret.
# Newer projects sign asymmetrically — leave this BLANK and the API verifies
# against the JWKS endpoint instead. Set one or the other, never both.
# Getting this wrong makes every request return UNAUTHENTICATED with a token
# that works fine in the Supabase dashboard. Decide it before you start.
SUPABASE_JWT_SECRET=

# ---- Cloudflare R2 ---------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=smartkasi
R2_PUBLIC_BASE_URL=https://cdn.smartkasi.co.za

# ---- Service fee model -----------------------------------------------------
# service_fee = base + per_extra_shop x (shops - 1) + per_km x ceil(km)
# These are placeholders — see open question 1 in docs/API_CONTRACT.md.
FEE_BASE_CENTS=1000
FEE_PER_EXTRA_SHOP_CENTS=500
FEE_PER_KM_CENTS=150
MAX_BASKET_SPREAD_M=2000

# Share of the service fee paid to the courier, as a percentage. The rest is the
# platform cut. Placeholder — see open question 3 in docs/API_CONTRACT.md.
FEE_COURIER_SHARE_PCT=80
